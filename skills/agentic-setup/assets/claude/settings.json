{
  "permissions": {
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Source control: github.com/<owner>/<repo> (push, branch, PR on this repo)",
      "Deployment: <hosting provider> project <name> (env vars, deploys from main via Git only)",
      "Database: <provider> project <name> (migrations via CI/production builds only)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-body-check.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-body-refresh.sh", "timeout": 15 }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": false,
    "repo-typescript-lsp@repo": true
  },
  "extraKnownMarketplaces": {
    "repo": { "source": { "source": "directory", "path": "./.claude/marketplace" } }
  }
}
